    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../LinuxInvaders.Core/Content/Icon.ico</ApplicationIcon>
    <AssemblyName>LinuxInvaders</AssemblyName>
