  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LinuxInvaders.Core\LinuxInvaders.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
